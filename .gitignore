# ---------- Secrets and local configuration ----------
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
service-account*.json
.npmrc
.netrc

# ---------- Local tooling and editor files ----------
.claude/
.vscode/
.idea/
*.code-workspace
*.swp
*~

# ---------- Logs and temp files ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
scratch/

